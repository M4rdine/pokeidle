DATABASE_URL=postgres://pokeidle:pokeidle@localhost:5433/pokeidle
DATABASE_URL_TEST=postgres://pokeidle:pokeidle@localhost:5433/pokeidle_test
PORT=3000
APP_ORIGIN=http://localhost:3000
# Em dev com o Vite (pnpm client:dev, porta 5173) use APP_ORIGIN=http://localhost:5173: o navegador manda Origin 5173 e o servidor recusa outra origem (S11).
COOKIE_SECURE=false
# false (padrão) | true | um inteiro >= 1 (nº de hops confiados) | lista de IPs/CIDRs separada
# por vírgula. Só use "true" atrás de um proxy que SOBRESCREVE X-Forwarded-For — do
# contrário qualquer cliente pode forjar o cabeçalho e escapar do rate limit por IP.
TRUST_PROXY=false
LOG_LEVEL=info
# Visualizador de depuração descartável em /debug (nunca ligar em produção). Ligue só em dev.
DEBUG_VIEWER=false
# Diretório do atlas de assets (padrão: <repo>/assets/atlas, gerado por `pnpm assets build`).
# ASSETS_DIR=
# Build do cliente servido em / (padrão: <repo>/packages/client/dist; sem a pasta, / é 404).
# CLIENT_DIST=
