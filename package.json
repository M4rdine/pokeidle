{
  "name": "pokeidle",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test": "pnpm -r test",
    "assets": "tsx tools/assets/src/main.ts",
    "mapa": "tsx tools/assets/scripts/desenhar-regiao.ts",
    "pokedata": "tsx tools/pokedata/src/main.ts",
    "shared:test": "pnpm --filter @pokeidle/shared test",
    "server:test": "pnpm --filter @pokeidle/server test",
    "server:dev": "pnpm --filter @pokeidle/server dev",
    "client:dev": "pnpm --filter @pokeidle/client dev",
    "client:build": "pnpm --filter @pokeidle/client build",
    "client:test": "pnpm --filter @pokeidle/client test",
    "client:e2e": "pnpm --filter @pokeidle/client e2e",
    "db:up": "docker compose up -d",
    "cores": "tsx tools/assets/scripts/cores-do-mundo.ts",
    "icones": "tsx tools/assets/scripts/ui-icones.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
